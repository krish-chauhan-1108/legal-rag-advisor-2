# =============================================================================
# Legal RAG Advisor — Environment Configuration
# Copy this file to .env and customize if needed.
# =============================================================================

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  Google Gemini API is now used for the LLM!                           │
# │  Get your key from Google AI Studio: https://aistudio.google.com/     │
# └─────────────────────────────────────────────────────────────────────────┘

# Your Gemini API Key
GEMINI_API_KEY=your_api_key_here

# LLM model (e.g. gemma-4-26b-a4b-it, gemini-2.5-flash)
LLM_MODEL=gemma-4-26b-a4b-it

# Embedding model (runs locally via Ollama)
EMBEDDING_MODEL=nomic-embed-text

# Re-ranking model (runs locally via sentence-transformers)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Document upload directory
UPLOAD_DIR=./data/uploads

# Logging level
LOG_LEVEL=INFO
