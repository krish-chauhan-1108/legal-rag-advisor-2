# =============================================================================
# Legal RAG Advisor — Environment Configuration
# Copy this file to .env and customize if needed.
# =============================================================================

# ┌─────────────────────────────────────────────────────────────────────────┐
# │  Google Gemini API is now used for the LLM!                           │
# │  Get your key from Google AI Studio: https://aistudio.google.com/     │
# └─────────────────────────────────────────────────────────────────────────┘

# Gemini API keys. The backend rotates through these when a quota/rate-limit
# response is received. Keep these values server-side; never put them in Vercel.
GEMINI_API_KEY=your_primary_key_here
GEMINI_API_KEY_FALLBACK=your_fallback_key_here
GEMINI_API_KEY_3=your_third_key_here
GEMINI_API_KEY_4=your_fourth_key_here

# Comma-separated Google accounts allowed to use the admin API.
ADMIN_EMAILS=you@example.com
# Fernet key for encrypting API keys stored in the database.
# Generate: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
API_KEY_ENCRYPTION_KEY=your_fernet_key_here

# LLM model (e.g. gemma-4-26b-a4b-it, gemini-2.5-flash)
LLM_MODEL=gemma-4-26b-a4b-it

# Gemini embedding model
EMBEDDING_MODEL=models/gemini-embedding-2

# Re-ranking model (runs locally via sentence-transformers)
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2

# ChromaDB persistence directory
CHROMA_PERSIST_DIR=./data/chroma_db

# Document upload directory
UPLOAD_DIR=./data/uploads

# Logging level
LOG_LEVEL=INFO

# Server/runtime settings
PORT=8000
DATABASE_URL=sqlite:///./legal.db
# Long random token required by POST /api/admin/import-seed
SEED_UPLOAD_TOKEN=generate_a_long_random_token_here

# Frontend build setting (put this in frontend/.env locally and in Vercel)
# VITE_API_URL=http://localhost:8000
